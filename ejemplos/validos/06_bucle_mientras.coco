# Ejemplo 6: bucle mientras (while) con acumulador
# Demuestra control de flujo y proposito general

contador = 1;
acumulador = 0;

mientras (contador <= 5) {
    imprimir contador;
    acumulador = acumulador + contador;
    contador = contador + 1;
}

imprimir "Total acumulado:";
imprimir acumulador;
